{
  "name": "henu-os-records",
  "version": "1.0.0",
  "description": "HENU OS Records Management / HLABS Filing System",
  "main": "dist/main/index.js",
  "author": "HLabs",
  "license": "UNLICENSED",
  "scripts": {
    "dev:renderer": "vite --port 5174",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "watch:main": "tsc -p tsconfig.main.json -w",
    "dev": "npm run build:main && concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5174 && node scripts/launch-electron.js\"",
    "start": "node scripts/launch-electron.js",
    "desktop": "npm run build:main && concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5174 && powershell -Command \\\"$env:ELECTRON_DISABLE_SANDBOX=1; & 'G:\\Astro\\node_modules\\electron\\dist\\electron.exe' 'G:\\Astro' --no-sandbox --disable-gpu --no-crashpad\\\"\"",
    "build": "npm run build:renderer && npm run build:main && node copy-templates.js",
    "package": "node scripts/build-installer.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.427.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "regenerator-runtime": "^0.14.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.35.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hlabs.henuos.records",
    "productName": "HENU OS RECMA",
    "compression": "normal",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "henu_business.ico",
      "henu_business.png",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "henu_business.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HENU OS RECMA",
      "installerIcon": "henu_business.ico",
      "uninstallerIcon": "henu_business.ico",
      "installerHeaderIcon": "henu_business.ico",
      "runAfterFinish": true,
      "artifactName": "${productName} Setup.${ext}"
    },
    "asar": true
  }
}
